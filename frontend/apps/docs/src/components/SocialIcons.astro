---
/**
 * T1162 — the marketing site's top-level links in the docs header, before
 * Starlight's own icons, so a reader can go back to the product pages from any
 * page here. Anchored on the site root (SITE_ROOT), as the site's own nav is.
 */
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import { SITE_ROOT } from "../../site.mjs";

const links = [
  { label: "Home", href: `${SITE_ROOT}/` },
  { label: "Try it live", href: `${SITE_ROOT}/#playground` },
  // T1269: an ordinary link, as on the site; the hub's header has no pills.
  { label: "AEM AI Search", href: `${SITE_ROOT}/aem-search/` },
];
---

<nav class="turing-nav" aria-label="Viglet Turing">
  {
    links.map((link) => (
      <a href={link.href} class="turing-nav-link">
        {link.label}
      </a>
    ))
  }
</nav>
<Default />

<style>
  .turing-nav {
    display: none;
    align-items: center;
    gap: 1.1rem;
    margin-inline-end: 0.5rem;
  }
  .turing-nav-link {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    white-space: nowrap;
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .turing-nav-link:hover {
    color: var(--sl-color-white);
  }
  @media (min-width: 64rem) {
    .turing-nav {
      display: flex;
    }
  }
</style>
