---
/**
 * T1162 — the marketing site's top-level links in the docs header, before
 * Starlight's own icons, so a reader can go back to the product pages from any
 * page here. Root-anchored on turing.viglet.org, as the site's own nav is.
 */
import Default from "@astrojs/starlight/components/SocialIcons.astro";

const links = [
  { label: "Home", href: "/" },
  { label: "Try it live", href: "/#playground" },
  { label: "AEM AI Search", href: "/aem-search/", highlight: true },
];
---

<nav class="turing-nav" aria-label="Viglet Turing">
  {
    links.map((link) => (
      <a href={link.href} class:list={["turing-nav-link", { "turing-nav-pill": link.highlight }]}>
        {link.label}
      </a>
    ))
  }
</nav>
<Default />

<style>
  .turing-nav {
    display: none;
    align-items: center;
    gap: 1.1rem;
    margin-inline-end: 0.5rem;
  }
  .turing-nav-link {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    white-space: nowrap;
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .turing-nav-link:hover {
    color: var(--sl-color-white);
  }
  .turing-nav-pill {
    color: var(--sl-color-accent);
    background: color-mix(in oklab, var(--sl-color-accent) 12%, transparent);
    border: 1px solid color-mix(in oklab, var(--sl-color-accent) 35%, transparent);
    border-radius: 999px;
    padding: 0.2rem 0.75rem;
    font-weight: 700;
  }
  @media (min-width: 64rem) {
    .turing-nav {
      display: flex;
    }
  }
</style>
