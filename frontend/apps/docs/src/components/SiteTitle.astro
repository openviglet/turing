---
/**
 * T1162 — the header's brand, as the marketing site draws it: the cube mark and
 * "Viglet Turing", a "Docs" label, and the "part of viglet.org" link (plain
 * text since T1269, as the hub draws it). Starlight's own SiteTitle renders the
 * logo and the link to the docs home.
 */
import Default from "@astrojs/starlight/components/SiteTitle.astro";
---

<div class="turing-brand">
  <Default />
  <span class="turing-docs-label">Docs</span>
  <a class="turing-viglet-link" href="https://www.viglet.org" target="_blank" rel="noreferrer">part of viglet.org ↗</a>
</div>

<style>
  .turing-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }
  .turing-docs-label {
    font-size: var(--sl-text-sm);
    font-weight: 700;
    color: var(--sl-color-accent);
    padding-inline-start: 0.6rem;
    border-inline-start: 1px solid var(--sl-color-hairline);
  }
  .turing-viglet-link {
    display: none;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    white-space: nowrap;
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .turing-viglet-link:hover {
    color: var(--sl-color-white);
  }
  @media (min-width: 72rem) {
    .turing-viglet-link {
      display: inline-flex;
    }
  }
</style>
