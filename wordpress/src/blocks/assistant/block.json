{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "viglet-dumont/assistant",
	"title": "Site assistant",
	"category": "widgets",
	"icon": "format-chat",
	"description": "A button that opens a conversation with Turing's chat: visitors ask in their own words and get an answer generated from this site's posts, with the posts it used.",
	"keywords": [ "chat", "assistant", "question", "turing" ],
	"textdomain": "viglet-dumont",
	"attributes": {
		"heading": {
			"type": "string",
			"default": ""
		},
		"suggestions": {
			"type": "string",
			"default": ""
		},
		"floating": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"spacing": { "margin": true, "padding": true },
		"color": { "background": true, "text": true, "link": true },
		"typography": { "fontSize": true, "lineHeight": true },
		"interactivity": true
	},
	"editorScript": "viglet-dumont-assistant-block-editor",
	"style": "viglet-dumont-assistant-block",
	"viewScriptModule": "viglet-dumont/assistant-block",
	"render": "file:./render.php"
}
