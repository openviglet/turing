{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "viglet-dumont/copilot",
	"title": "Ask this site",
	"category": "widgets",
	"icon": "format-chat",
	"description": "A conversation with Turing's copilot: a request in plain words answered from this site's content, with the items it cites. A described plan can be turned into the items it needs, grouped by need; on a WooCommerce shop those are products that go in the cart together.",
	"keywords": [ "copilot", "assistant", "ask", "turing" ],
	"textdomain": "viglet-turing-search",
	"attributes": {
		"heading": {
			"type": "string",
			"default": ""
		},
		"placeholder": {
			"type": "string",
			"default": ""
		},
		"kit": {
			"type": "boolean"
		},
		"planOnly": {
			"type": "boolean",
			"default": false
		},
		"stageTypes": {
			"type": "string",
			"default": ""
		},
		"guideTypes": {
			"type": "string",
			"default": ""
		},
		"availabilityField": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true, "blockGap": true },
		"color": { "background": true, "text": true, "link": true },
		"typography": { "fontSize": true, "lineHeight": true },
		"interactivity": true
	},
	"editorScript": "viglet-dumont-copilot-block-editor",
	"style": "viglet-dumont-copilot-block",
	"viewScriptModule": "viglet-dumont/copilot-block",
	"render": "file:./render.php"
}
