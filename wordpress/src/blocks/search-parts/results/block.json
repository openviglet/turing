{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "viglet-dumont/search-results",
	"title": "Search results",
	"category": "widgets",
	"icon": "list-view",
	"description": "The Turing search block’s results: the count, the sort, the answer and the list.",
	"textdomain": "viglet-dumont",
	"ancestor": [
		"viglet-dumont/search"
	],
	"usesContext": [
		"viglet-dumont/search/placeholder",
		"viglet-dumont/search/showFacets",
		"viglet-dumont/search/showSort",
		"viglet-dumont/search/showAnswer",
		"viglet-dumont/search/suggestFilters", "viglet-dumont/search/applyFilters",
		"viglet-dumont/search/showImage",
		"viglet-dumont/search/showDate",
		"viglet-dumont/search/showType",
		"viglet-dumont/search/showSnippet"
	],
	"supports": {
		"html": false,
		"reusable": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "viglet-dumont-search-block-editor",
	"render": "file:../render.php"
}
