{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "viglet-turing/search-box",
	"title": "Search box",
	"category": "widgets",
	"icon": "search",
	"description": "The Turing search block’s box: the field, its suggestions and “Did you mean”.",
	"textdomain": "viglet-turing-search",
	"ancestor": [
		"viglet-turing/search"
	],
	"usesContext": [
		"viglet-turing/search/placeholder",
		"viglet-turing/search/showFacets",
		"viglet-turing/search/showSort",
		"viglet-turing/search/showAnswer",
		"viglet-turing/search/suggestFilters", "viglet-turing/search/applyFilters", "viglet-turing/search/showTrending",
		"viglet-turing/search/showImage",
		"viglet-turing/search/showDate",
		"viglet-turing/search/showType",
		"viglet-turing/search/showSnippet",
		"viglet-turing/search/filters"
	],
	"supports": {
		"html": false,
		"reusable": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "viglet-turing-search-block-editor",
	"render": "file:../render.php"
}
