#: src/includes/class-viglet-dumont-diagnostics.php:49
msgid "The Turing URL must be a full http:// or https:// address, e.g. https://search.example.org."
msgstr "A URL do Turing precisa ser um endereço completo http:// ou https://, ex.: https://busca.exemplo.org."

#: src/includes/class-viglet-dumont-diagnostics.php:51
msgid "The URL is well formed."
msgstr "A URL está bem formada."

#: src/includes/class-viglet-dumont-diagnostics.php:57
msgid "The server answers."
msgstr "O servidor responde."

#. translators: %d: the HTTP status the server answered with.
#: src/includes/class-viglet-dumont-diagnostics.php:66
#, php-format
msgid "The server answered HTTP %d where Turing answers its discovery document: this URL is not a Turing, or a proxy is in the way."
msgstr "O servidor respondeu HTTP %d onde o Turing responde o seu documento de descoberta: esta URL não é de um Turing, ou há um proxy no caminho."

#: src/includes/class-viglet-dumont-diagnostics.php:69
msgid "It is a Turing."
msgstr "É um Turing."

#: src/includes/class-viglet-dumont-diagnostics.php:72
msgid "No API key is set. Create one in Turing under API Tokens and paste it here."
msgstr "Nenhuma chave de API definida. Crie uma no Turing em API Tokens e cole aqui."

#: src/includes/class-viglet-dumont-diagnostics.php:85
msgid "Turing refused the API key: it is wrong, expired, or its user cannot manage SN sites."
msgstr "O Turing recusou a chave de API: ela está errada, expirou, ou o seu usuário não pode gerenciar sites SN."

#: src/includes/class-viglet-dumont-diagnostics.php:89
msgid "Turing accepts the API key."
msgstr "O Turing aceita a chave de API."

#. translators: %s: the SN site's name.
#: src/includes/class-viglet-dumont-diagnostics.php:96
#, php-format
msgid "The SN site %s exists."
msgstr "O site SN %s existe."

#. translators: %s: the SN site's name.
#: src/includes/class-viglet-dumont-diagnostics.php:101
#, php-format
msgid "There is no SN site named %s in Turing yet. Create it from here, or check the name."
msgstr "Ainda não há site SN chamado %s no Turing. Crie-o daqui, ou confira o nome."

#. translators: %s: the host name.
#: src/includes/class-viglet-dumont-diagnostics.php:122
#, php-format
msgid "%s does not resolve (DNS): check the address for typos, or whether this server can see that network."
msgstr "%s não resolve (DNS): confira se o endereço tem erro de digitação, ou se este servidor enxerga essa rede."

#. translators: %s: the transport's own message.
#: src/includes/class-viglet-dumont-diagnostics.php:126
#, php-format
msgid "The secure connection failed (TLS): the certificate is invalid, expired or self-signed. Details: %s"
msgstr "A conexão segura falhou (TLS): o certificado é inválido, expirou ou é autoassinado. Detalhes: %s"

#. translators: %s: the host name.
#: src/includes/class-viglet-dumont-diagnostics.php:130
#, php-format
msgid "%s did not answer in time: a firewall may be dropping the connection, or Turing is down."
msgstr "%s não respondeu a tempo: um firewall pode estar descartando a conexão, ou o Turing está fora do ar."

#. translators: %s: the host name.
#: src/includes/class-viglet-dumont-diagnostics.php:134
#, php-format
msgid "Nothing is listening at %s on that port: Turing is down, or the port is wrong."
msgstr "Nada responde em %s nessa porta: o Turing está fora do ar, ou a porta está errada."

#. translators: %d: how many documents were indexed.
#: src/includes/class-viglet-dumont-indexer.php:207
